{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "rootDir": "frontend",
    "outDir": "public",
    "strict": true,
    "noEmitOnError": true,
    "verbatimModuleSyntax": true,
    "newLine": "lf"
  },
  "include": [
    "frontend/**/*.ts"
  ]
}
